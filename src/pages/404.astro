---
import '@/styles/globals.css';
import Layout from '@/layouts/Layout.astro';
import MainNav from '@/components/MainNav.astro';
import ThemeInitScript from '@/components/ThemeInitScript.astro';
---

<ThemeInitScript />

<Layout title="Rohan Poojary - 404" description="Oops! Page not Found :(" noindex={true}>
	<main id="main-content" class="px-3 mx-auto max-w-(--breakpoint-lg) xl:max-w-[1140px]">
		<MainNav />
        <div class="pt-12 pb-12">
            <h1 class="font-bold">404: Page Not Found!</h1>
            <p>Sorry, but the page you were looking for could not be found.</p>
        </div>
	</main>
</Layout>
