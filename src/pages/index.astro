---
import '@/styles/globals.css';
import Layout from '@/layouts/Layout.astro';
import MainNav from '@/components/MainNav.astro';
import About from '@/components/About.astro';
import Intro from '@/components/Intro.astro';
import Footer from '@/components/Footer.astro';
import Experience from '@/components/Experience.astro';
import ScrollToTop from '@/components/ScrollToTop';
import ThemeInitScript from '@/components/ThemeInitScript.astro';

const personJsonLd = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: "Rohan Poojary",
	url: "https://rohanpoojary.com",
	jobTitle: "Full Stack Engineer",
	worksFor: {
		"@type": "Organization",
		name: "Canny",
		url: "https://canny.io"
	},
	address: {
		"@type": "PostalAddress",
		addressLocality: "Toronto",
		addressCountry: "CA"
	},
	sameAs: [
		"https://www.linkedin.com/in/rohanpoojary/",
		"https://github.com/RohanPoojary1107"
	]
};
---

<ThemeInitScript />

<Layout 
	title="Rohan Poojary's Portfolio"
	description="Full stack engineer based in Toronto building scalable, user-focused products with React, Node.js, TypeScript, and AWS."
>
	<script is:inline type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
	<main id="main-content" class="px-3 mx-auto max-w-(--breakpoint-lg) xl:max-w-[1140px]">
		<MainNav />
		<Intro />
		<About />
		<Experience />
		<Footer />
		<ScrollToTop client:idle />
	</main>
</Layout>
