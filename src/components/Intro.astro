---
import SocialLinks from "@/components/SocialLinks.astro";
---

<section class="pt-32 md:pt-48 lg:pt-64 pb-14 md:pb-18 flex flex-col scroll-mt-16">
  <div class="text-left">
    <h1 class="text-5xl md:text-6xl font-bold leading-tight tracking-tight mb-4">
      <span class="block">Hey, I'm Rohan <span class="inline-block origin-[70%_70%] animate-wave">👋🏽</span></span>
    </h1>
    <h2 class="text-4xl md:text-5xl font-bold leading-tight tracking-tight">
      <span class="block">
        <span class="text-zinc-500 dark:text-zinc-400">I'm a </span>
        <span>full stack engineer</span>
      </span>
      <span class="block">
        <span class="text-zinc-500 dark:text-zinc-400">based in </span>
        <span>Toronto</span>
      </span>
    </h2>
    <SocialLinks variant="intro" />
  </div>
</section>
